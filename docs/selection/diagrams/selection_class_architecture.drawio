        <mxCell id="e9" value="final_tickers + matrices" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="corr-flow" target="contract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yf-source" value="Fuente externa compartida&#10;research.assets_research.yf&#10;&#10;YahooFundamentalsProvider usa yf.Ticker.&#10;CorrelationPortfolioSelector usa yf.download.&#10;&#10;No existe dependencia directa entre ambas clases." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="290" height="190" as="geometry" /></mxCell><mxCell id="e10a" value="yf.Ticker" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="yf-source" target="provider"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="560" /></Array></mxGeometry></mxCell><mxCell id="e10b" value="yf.download" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="yf-source" target="corr-selector"><mxGeometry relative="1" as="geometry" /></mxCell></root>
