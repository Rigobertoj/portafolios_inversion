<mxfile host="app.diagrams.net" modified="2026-05-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="selection-workflow-linear" name="Selection Workflow Linear">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="selection: flujo organico y lineal de uso" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1B1F23;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="1260" height="42" as="geometry" />
        </mxCell>
        <mxCell id="principle" value="Lectura de arriba hacia abajo: definir universo, elegir pregunta dominante, ejecutar ruta, revisar compuertas, consolidar lista corta y entregar a optimization. Las bifurcaciones son decisiones metodologicas, no modulos aislados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="160" y="82" width="1380" height="66" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="1. Definir mandato&#10;&#10;Objetivo de inversion, restricciones, sectores, horizonte, fechas de datos, liquidez minima y tesis inicial.&#10;&#10;Output: universe policy + lista amplia candidata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2. Preparar universo amplio&#10;&#10;Normalizar tickers, eliminar duplicados, separar grupos si habra analisis de correlacion y decidir top_k preliminar.&#10;&#10;Output: tickers o grouped_tickers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="430" height="140" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="3. Decision&#10;&#10;Que filtro domina la primera etapa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="565" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fund1" value="4A. Ruta fundamental&#10;&#10;FundamentalSelector(strategy)&#10;rank(tickers)&#10;&#10;Operativo:&#10;descarga datos, construye metricas y calcula ranking por percentiles ponderados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="800" width="360" height="185" as="geometry" />
        </mxCell>
        <mxCell id="fund2" value="5A. Revision fundamental&#10;&#10;selection_report(top_k)&#10;metric_evolution(...)&#10;&#10;Conceptual:&#10;verificar si el top-k esta explicado por la tesis o por datos incompletos/outliers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="1040" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="fundgate" value="6A. Gate fundamental&#10;&#10;Aceptar si:&#10;- score components coherentes&#10;- metric_snapshot suficiente&#10;- top-k diversificado por sector/tesis&#10;&#10;Salida: selected_tickers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="1280" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="corr1" value="4B. Ruta correlacion&#10;&#10;CorrelationPortfolioSelector(start_date, end_date)&#10;rank_within_groups(grouped_tickers)&#10;&#10;Operativo:&#10;descarga precios, calcula retornos y rankea activos de menor correlacion intra-grupo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="800" width="360" height="205" as="geometry" />
        </mxCell>
        <mxCell id="corr2" value="5B. Revision de diversificacion&#10;&#10;build_multigroup_portfolio(...)&#10;update_portfolio(...) si ya existe cartera&#10;&#10;Conceptual:&#10;la correlacion mide redundancia estadistica, no calidad economica del activo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1060" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="corrgate" value="6B. Gate de correlacion&#10;&#10;Aceptar si:&#10;- final_corr_matrix razonable&#10;- final_mean_offdiag_corr bajo&#10;- cobertura de precios suficiente&#10;&#10;Salida: final_tickers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1300" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="7. Consolidar lista corta&#10;&#10;Combinar rutas por union, interseccion o regla de negocio.&#10;&#10;Output operativo:&#10;tickers_finales + evidencia por activo.&#10;&#10;Decision metodologica:&#10;selection entrega candidatos explicables, no pesos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="1100" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="handoff" value="8. Handoff a optimization&#10;&#10;Input al siguiente modulo:&#10;- tickers_finales&#10;- ventanas de datos sugeridas&#10;- notas de tesis/cobertura&#10;&#10;optimization decidira pesos, objetivo, constraints y solver." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="1390" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="Feedback posterior&#10;&#10;Despues de backtesting, performance analysis y risk/reporting:&#10;- ajustar metric_weights&#10;- cambiar grupos&#10;- excluir activos con mala cobertura&#10;- revisar estabilidad historica&#10;- iterar seleccion con nueva tesis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="790" width="430" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="define universo" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="prepara inputs" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="step2" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="value/growth" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="decision" target="fund1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="ranking + reporte" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="fund1" target="fund2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="aprobacion" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="fund2" target="fundgate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="selected_tickers" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="fundgate" target="merge">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="1375" />
              <mxPoint x="520" y="1210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="diversificacion" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="decision" target="corr1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="matriz + scores" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="corr1" target="corr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="aprobacion" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="corr2" target="corrgate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="final_tickers" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="corrgate" target="merge">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="1395" />
              <mxPoint x="1120" y="1210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="tickers_finales" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#6C8EBF;" edge="1" parent="1" source="merge" target="handoff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="resultados posteriores" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;fontSize=11;strokeColor=#666666;" edge="1" parent="1" source="handoff" target="feedback">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="835" y="1600" />
              <mxPoint x="420" y="1600" />
              <mxPoint x="420" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="ajustar tesis" style="endArrow=block;html=1;rounded=0;dashed=1;strokeWidth=2;fontSize=11;strokeColor=#666666;" edge="1" parent="1" source="feedback" target="step1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="900" />
              <mxPoint x="520" y="245" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
