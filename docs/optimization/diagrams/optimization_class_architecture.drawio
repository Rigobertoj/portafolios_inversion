<mxfile host="app.diagrams.net" modified="2026-05-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="optimization-class-architecture-linear" name="Optimization Class Architecture Linear"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2450" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="optimization: arquitectura de clases, funciones y conceptos" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1B1F23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="1650" height="42" as="geometry" /></mxCell><mxCell id="external" value="Contexto externo&#10;&#10;Portfolio:&#10;prices, returns, tickers, weight&#10;&#10;AssetsResearch:&#10;tickers, start, end, price_field, caches de prices / returns&#10;&#10;Estas clases proveen datos; no deciden el objetivo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="320" height="270" as="geometry" /></mxCell><mxCell id="configs" value="Configs como contrato&#10;&#10;OptimizationConfig&#10;MinimumVarianceConfig&#10;PostModernOptimizationConfig&#10;MinimumSemivarianceConfig&#10;MaximumOmegaConfig&#10;&#10;Validan intencion de inversion:&#10;risk_free_rate, threshold, allow_short, bounds, initial_weights, minimum_return, solver_options." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="320" height="320" as="geometry" /></mxCell><mxCell id="portfolio_opt" value="PortfolioOptimization&#10;mean_variance.py&#10;&#10;Hereda AssetsResearch.&#10;Estado: __weight validado.&#10;&#10;Metodos base:&#10;_validate_weight, _resolve_bounds, _resolve_initial_weights, _solve, _build_result.&#10;&#10;Metricas:&#10;portfolio_annual_return, portfolio_variance, volatility, sharpe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="145" width="360" height="330" as="geometry" /></mxCell><mxCell id="mv_calc" value="Nucleo media-varianza&#10;&#10;Inputs calculados:&#10;mu = annual_return(...)&#10;Sigma = covariance(...) * 252&#10;&#10;Objetivos:&#10;minimum_variance -&gt; w.T @ Sigma @ w&#10;maximum_sharpe -&gt; -((w @ mu - rf) / volatility)&#10;&#10;Restricciones:&#10;sum(w)=1 y retorno minimo opcional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="380" height="360" as="geometry" /></mxCell><mxCell id="mv_adapter" value="MeanVarianceOptimizer&#10;&#10;Dataclass con portfolio.&#10;&#10;_build_optimizer():&#10;crea PortfolioOptimization e inyecta asset_prices y asset_returns.&#10;&#10;_apply_optimized_weights():&#10;solo muta portfolio.weight si result.success." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1410" y="165" width="340" height="280" as="geometry" /></mxCell><mxCell id="postmodern" value="PortfolioOptimizationPostModern&#10;postmodern.py&#10;&#10;Extiende PortfolioOptimization.&#10;Estado y cache por threshold:&#10;returns_down, returns_up, shortfall_risk, upside_potential, semivariance, omega.&#10;&#10;Acepta benchmark_returns en minima semivarianza sin cache persistente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="380" height="340" as="geometry" /></mxCell><mxCell id="pm_calc" value="Nucleo downside&#10;&#10;_reference_adjusted_returns:&#10;asset_returns - threshold&#10;o asset_returns - (benchmark + threshold)&#10;&#10;returns_below / returns_above separan desviaciones.&#10;&#10;semivariance_matrix = outer(downside_risk) * corr&#10;omega = upside_risk / downside_risk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="670" width="390" height="370" as="geometry" /></mxCell><mxCell id="pm_adapter" value="PostModernOptimizer&#10;&#10;Dataclass con portfolio.&#10;&#10;_build_optimizer():&#10;crea PortfolioOptimizationPostModern e inyecta caches del Portfolio.&#10;&#10;Objetivos:&#10;optimize_minimum_semivariance&#10;optimize_maximum_omega" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1430" y="705" width="340" height="280" as="geometry" /></mxCell><mxCell id="solver" value="Solve contract&#10;&#10;scipy.optimize.minimize recibe:&#10;- objective_function&#10;- x0 initial_weights&#10;- method solver_method&#10;- bounds&#10;- constraints&#10;- solver_options&#10;&#10;Devuelve solution.x, success, status, message, nit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1840" y="420" width="310" height="300" as="geometry" /></mxCell><mxCell id="results" value="Result dataclasses&#10;results.py&#10;&#10;OptimizationResult:&#10;expected_return, variance, volatility, sharpe, objective_value.&#10;&#10;PostModernOptimizationResult:&#10;expected_return, semivariance, downside_risk, omega, objective_value.&#10;&#10;Ambos exponen weights_by_ticker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200" y="420" width="220" height="330" as="geometry" /></mxCell><mxCell id="backtesting" value="Consumo por estrategias&#10;backtesting/strategies.py&#10;&#10;MeanVarianceStrategy y PostModernStrategy convierten ventanas de precios en StrategyAllocation.&#10;&#10;El motor no conoce formulas: solo recibe pesos, etiquetas y raw optimizer result." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1010" y="1120" width="540" height="200" as="geometry" /></mxCell><mxCell id="note" value="Lectura del subconjunto&#10;&#10;La vista se centra en las clases publicas y contratos. Los adaptadores modernos son delgados; el calculo vive en los optimizadores historicos para preservar compatibilidad con notebooks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="1120" width="560" height="180" as="geometry" /></mxCell><mxCell id="e1" value="herencia" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="external" target="portfolio_opt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="parametros solver" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="configs" target="portfolio_opt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="mu / Sigma / weight" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="portfolio_opt" target="mv_calc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Portfolio -&gt; caches" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="external" target="mv_adapter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="100" /><mxPoint x="1580" y="100" /></Array></mxGeometry></mxCell><mxCell id="e5" value="delegacion" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="mv_adapter" target="portfolio_opt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="505" /><mxPoint x="680" y="505" /></Array></mxGeometry></mxCell><mxCell id="e6" value="objective_function" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="mv_calc" target="solver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="subclase" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="portfolio_opt" target="postmodern"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="575" /></Array></mxGeometry></mxCell><mxCell id="e8" value="threshold / benchmark" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="configs" target="postmodern"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="downside matrices" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="postmodern" target="pm_calc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Portfolio -&gt; caches" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="external" target="pm_adapter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="1045" /><mxPoint x="1600" y="1045" /></Array></mxGeometry></mxCell><mxCell id="e11" value="delegacion" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="pm_adapter" target="postmodern"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="1080" /><mxPoint x="690" y="1080" /></Array></mxGeometry></mxCell><mxCell id="e12" value="objective_function" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="pm_calc" target="solver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="OptimizeResult" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="solver" target="results"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="result.success -&gt; update weights" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="results" target="backtesting"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2310" y="1040" /><mxPoint x="1280" y="1040" /></Array></mxGeometry></mxCell><mxCell id="e15" value="feedback de performance" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="backtesting" target="configs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="1340" /><mxPoint x="230" y="1340" /><mxPoint x="230" y="910" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
