<mxfile host="app.diagrams.net" modified="2026-05-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="optimization-workflow-organic" name="Optimization Workflow Organic"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="optimization: flujo organico y lineal de uso" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1B1F23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="1060" height="42" as="geometry" /></mxCell><mxCell id="s1" value="1. Definir mandato&#10;&#10;Universo de tickers, horizonte, capital conceptual, politica de cortos, retorno minimo, tasa libre de riesgo o threshold downside." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="105" width="660" height="135" as="geometry" /></mxCell><mxCell id="s2" value="2. Preparar datos&#10;&#10;Construir Portfolio con precios alineados y pesos iniciales, o usar la API historica con tickers, start, end y weight.&#10;&#10;Gate: pesos 1D, longitud correcta y suma igual a 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="660" height="175" as="geometry" /></mxCell><mxCell id="api" value="3. Elegir API&#10;&#10;Composicion o historica?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="665" y="540" width="370" height="170" as="geometry" /></mxCell><mxCell id="legacy" value="3A. Ruta historica&#10;&#10;PortfolioOptimization o PortfolioOptimizationPostModern.&#10;&#10;Util cuando el notebook parte de tickers y fechas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="110" y="775" width="450" height="160" as="geometry" /></mxCell><mxCell id="composition" value="3B. Ruta recomendada&#10;&#10;MeanVarianceOptimizer(portfolio) o PostModernOptimizer(portfolio).&#10;&#10;Util cuando los precios ya viven en Portfolio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1140" y="775" width="450" height="160" as="geometry" /></mxCell><mxCell id="contract" value="4. Contrato operativo comun&#10;&#10;El optimizador ya conoce asset_order, weight, prices y returns. La siguiente decision es el modelo de riesgo y el objetivo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="1010" width="660" height="150" as="geometry" /></mxCell><mxCell id="objective" value="5. Elegir objetivo&#10;&#10;Que riesgo quieres castigar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="665" y="1230" width="370" height="170" as="geometry" /></mxCell><mxCell id="mv" value="5A. Media-varianza&#10;&#10;minimum_variance:&#10;minimiza w.T @ Sigma @ w&#10;&#10;maximum_sharpe:&#10;minimiza Sharpe negativo&#10;&#10;Inputs: mu, Sigma, risk_free_rate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="110" y="1470" width="470" height="220" as="geometry" /></mxCell><mxCell id="pm" value="5B. Downside / post-moderno&#10;&#10;minimum_semivariance:&#10;minimiza matriz downside&#10;&#10;maximum_omega:&#10;maximiza upside / downside&#10;&#10;Inputs: threshold y benchmark opcional para semivarianza." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1470" width="470" height="240" as="geometry" /></mxCell><mxCell id="config" value="6. Configurar restricciones&#10;&#10;Resolver bounds, initial_weights, allow_short, minimum_return y solver_options.&#10;&#10;Gate: initial_weights debe cumplir bounds; bounds debe tener longitud por activo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="1770" width="660" height="180" as="geometry" /></mxCell><mxCell id="solve" value="7. Resolver con SLSQP&#10;&#10;Se arma objective_function, constraints=[sum(w)=1, retorno minimo opcional] y bounds.&#10;&#10;Salida bruta: solution.x, success, status, message, nit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="2020" width="660" height="170" as="geometry" /></mxCell><mxCell id="success" value="8. Gate de convergencia&#10;&#10;result.success?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="665" y="2255" width="370" height="140" as="geometry" /></mxCell><mxCell id="fail" value="8A. Falla controlada&#10;&#10;No mutar pesos.&#10;Revisar result.message, bounds, retorno minimo, datos faltantes o omega no finito." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="95" y="2240" width="420" height="165" as="geometry" /></mxCell><mxCell id="output" value="8B. Resultado aceptado&#10;&#10;Actualizar weight del Portfolio u optimizador historico.&#10;Entregar weights_by_ticker, metricas y diagnostico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1185" y="2240" width="420" height="165" as="geometry" /></mxCell><mxCell id="downstream" value="9. Uso posterior&#10;&#10;Backtesting aplica los pesos out-of-sample; risk/reporting revisa volatilidad, drawdown, VaR/CVaR, tracking y narrativa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="2510" width="660" height="165" as="geometry" /></mxCell><mxCell id="feedback" value="Feedback metodologico&#10;&#10;Si el backtest muestra concentracion, turnover alto, drawdowns o sensibilidad extrema, se ajustan universe, bounds, objective, threshold o ventana de datos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="2735" width="660" height="175" as="geometry" /></mxCell><mxCell id="e1" value="mandato" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="datos validos" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="s2" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="tickers / fechas" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="api" target="legacy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="750" /><mxPoint x="335" y="750" /></Array></mxGeometry></mxCell><mxCell id="e4" value="Portfolio" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="api" target="composition"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="750" /><mxPoint x="1365" y="750" /></Array></mxGeometry></mxCell><mxCell id="e5" value="estado inicial" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="legacy" target="contract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="970" /><mxPoint x="850" y="970" /></Array></mxGeometry></mxCell><mxCell id="e6" value="estado inicial" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="composition" target="contract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="970" /><mxPoint x="850" y="970" /></Array></mxGeometry></mxCell><mxCell id="e7" value="problema listo" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="contract" target="objective"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="castigar toda volatilidad" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="objective" target="mv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="1435" /><mxPoint x="345" y="1435" /></Array></mxGeometry></mxCell><mxCell id="e9" value="castigar downside" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="objective" target="pm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="1435" /><mxPoint x="1355" y="1435" /></Array></mxGeometry></mxCell><mxCell id="e10" value="objetivo + inputs" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="mv" target="config"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="1735" /><mxPoint x="850" y="1735" /></Array></mxGeometry></mxCell><mxCell id="e11" value="objetivo + inputs" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="pm" target="config"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="1745" /><mxPoint x="850" y="1745" /></Array></mxGeometry></mxCell><mxCell id="e12" value="restricciones" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="config" target="solve"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="solution" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#666666;" edge="1" parent="1" source="solve" target="success"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="no" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#666666;" edge="1" parent="1" source="success" target="fail"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="2430" /><mxPoint x="305" y="2430" /></Array></mxGeometry></mxCell><mxCell id="e15" value="si" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="success" target="output"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="2430" /><mxPoint x="1395" y="2430" /></Array></mxGeometry></mxCell><mxCell id="e16" value="StrategyAllocation / result" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="output" target="downstream"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="2485" /><mxPoint x="850" y="2485" /></Array></mxGeometry></mxCell><mxCell id="e17" value="aprendizaje" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="downstream" target="feedback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="ajustar supuestos" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="feedback" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="2825" /><mxPoint x="30" y="2825" /><mxPoint x="30" y="175" /><mxPoint x="500" y="175" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
