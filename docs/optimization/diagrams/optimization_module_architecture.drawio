<mxfile host="app.diagrams.net" modified="2026-05-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="optimization-module-architecture-linear" name="Optimization Module Architecture Linear"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="optimization: arquitectura lineal del modulo" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1B1F23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="1740" height="42" as="geometry" /></mxCell><mxCell id="flow" value="Flujo mayor: selection -&gt; portfolio / research -&gt; optimization -&gt; backtesting -&gt; risk / reporting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="78" width="2120" height="54" as="geometry" /></mxCell><mxCell id="mandate" value="0. Mandato y universo&#10;&#10;Input conceptual:&#10;- tickers candidatos&#10;- horizonte de inversion&#10;- politica long-only o long/short&#10;- retorno minimo o hurdle&#10;&#10;El modulo no selecciona activos: decide pesos bajo un objetivo explicito." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="290" height="240" as="geometry" /></mxCell><mxCell id="data" value="1. Datos de investigacion&#10;&#10;Rutas de entrada:&#10;- Portfolio con prices, returns, tickers, weight&#10;- AssetsResearch con tickers, start, end, price_field&#10;&#10;Contrato operativo:&#10;precios alineados, retornos calculables y pesos iniciales que suman 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="310" height="240" as="geometry" /></mxCell><mxCell id="api" value="2. API de entrada&#10;&#10;Que objeto controla los datos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="280" width="180" height="170" as="geometry" /></mxCell><mxCell id="legacy" value="3A. API historica&#10;mean_variance.py / postmodern.py&#10;&#10;PortfolioOptimization hereda AssetsResearch.&#10;PortfolioOptimizationPostModern extiende la ruta clasica con downside.&#10;&#10;Uso natural:&#10;notebooks con tickers, fechas y weight inicial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="145" width="340" height="250" as="geometry" /></mxCell><mxCell id="composition" value="3B. API por composicion&#10;MeanVarianceOptimizer / PostModernOptimizer&#10;&#10;Reciben Portfolio, construyen un optimizador historico e inyectan prices y returns en cache.&#10;&#10;Uso recomendado:&#10;codigo modular, pruebas y backtesting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="500" width="340" height="250" as="geometry" /></mxCell><mxCell id="configs" value="4. configs.py&#10;Contrato de supuestos&#10;&#10;OptimizationConfig:&#10;risk_free_rate, bounds, allow_short, initial_weights, solver_options&#10;&#10;PostModernOptimizationConfig:&#10;threshold, benchmark opcional por llamada&#10;&#10;Configs especificas:&#10;minimum_return, MaximumOmegaConfig." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1485" y="145" width="340" height="270" as="geometry" /></mxCell><mxCell id="mv" value="5A. Media-varianza&#10;mean_variance.py&#10;&#10;Objetivos:&#10;- minimum_variance&#10;- maximum_sharpe&#10;&#10;Calculos:&#10;mu anualizado, Sigma anualizada, w @ mu, w.T @ Sigma @ w, Sharpe negativo para maximizar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1485" y="500" width="340" height="270" as="geometry" /></mxCell><mxCell id="pm" value="5B. Downside / post-moderno&#10;postmodern.py&#10;&#10;Objetivos:&#10;- minimum_semivariance&#10;- maximum_omega&#10;&#10;Calculos:&#10;returns_below, returns_above, downside_risk, upside_risk, semivariance_matrix, omega_vector." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1485" y="815" width="340" height="270" as="geometry" /></mxCell><mxCell id="solver" value="6. scipy.optimize.minimize&#10;Control numerico&#10;&#10;Metodo default: SLSQP&#10;Restricciones:&#10;- sum(w) = 1&#10;- w @ mu &gt;= minimum_return si aplica&#10;Bounds:&#10;- [0, 1] long-only&#10;- [-1, 1] con allow_short&#10;- bounds explicitos por activo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1900" y="360" width="350" height="300" as="geometry" /></mxCell><mxCell id="results" value="7. results.py&#10;Contrato auditable&#10;&#10;OptimizationResult:&#10;weights, weights_by_ticker, expected_return, variance, volatility, sharpe&#10;&#10;PostModernOptimizationResult:&#10;semivariance, downside_risk, omega&#10;&#10;Ambos guardan success, status, message e iterations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2320" y="350" width="250" height="320" as="geometry" /></mxCell><mxCell id="handoff" value="8. Handoff downstream&#10;&#10;Si success=True:&#10;- se actualizan los pesos del Portfolio o del optimizador historico&#10;- backtesting recibe StrategyAllocation&#10;- risk/reporting interpreta pesos y metricas&#10;&#10;Si falla:&#10;se conservan pesos originales y se revisa message." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="945" width="500" height="240" as="geometry" /></mxCell><mxCell id="note" value="Limite del modulo&#10;&#10;optimization no descarga por decision propia cuando trabaja por composicion, no selecciona tickers, no simula capital y no calcula reportes finales. Su responsabilidad es formular y resolver la asignacion de pesos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="570" height="200" as="geometry" /></mxCell><mxCell id="e1" value="tickers + politica" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="mandate" target="data"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Portfolio o AssetsResearch" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="data" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="tickers / fechas" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="api" target="legacy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="215" /></Array></mxGeometry></mxCell><mxCell id="e4" value="Portfolio compuesto" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#5B7DB1;" edge="1" parent="1" source="api" target="composition"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="625" /></Array></mxGeometry></mxCell><mxCell id="e5" value="solver settings" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="legacy" target="configs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="solver settings" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#8A6D3B;" edge="1" parent="1" source="composition" target="configs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="mu + Sigma" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="configs" target="mv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="threshold / benchmark" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="configs" target="pm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="objetivo cuadratico" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="mv" target="solver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="objetivo downside" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="pm" target="solver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="OptimizeResult" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="solver" target="results"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="pesos + diagnostico" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="results" target="handoff"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2445" y="830" /><mxPoint x="1150" y="830" /></Array></mxGeometry></mxCell><mxCell id="e13" value="feedback de backtesting / risk" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="handoff" target="mandate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="1215" /><mxPoint x="210" y="1215" /><mxPoint x="210" y="520" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
