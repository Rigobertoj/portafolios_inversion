        <mxCell id="e7" value="selected_tickers + report" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#B85450;" edge="1" parent="1" source="selector" target="contract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="precios y retornos" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="corr-selector" target="corr-flow">
          <mxGeometry relative="1" as="geometry" />
