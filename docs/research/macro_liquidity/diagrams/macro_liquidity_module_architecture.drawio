  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e4" value="feature_panel validado" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="features" target="nowcast">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e5" value="scores *_score" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="nowcast" target="forecast">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e6" value="ForecastResult" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#7E5A8F;" edge="1" parent="1" source="forecast" target="classification">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e7" value="RegimeView" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#4D7F3A;" edge="1" parent="1" source="classification" target="scenarios">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e8" value="RegimeForecast" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#6C8EBF;" edge="1" parent="1" source="scenarios" target="assetview">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e9" value="AssetClassView" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#6C8EBF;" edge="1" parent="1" source="assetview" target="selection">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e10" value="ForecastPolicy" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#6C8EBF;" edge="1" parent="1" source="policy" target="forecast">
  <mxGeometry relative="1" as="geometry" />
</mxCell><mxCell id="e11" value="ScenarioPolicy" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#6C8EBF;" edge="1" parent="1" source="policy" target="scenarios">
